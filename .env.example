# ===== 火山方舟（豆包大模型） =====
# 控制台: https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-1-5-pro-32k-250115

# ===== 火山引擎视觉智能（OmniHuman 数字人视频） =====
# 控制台: https://console.volcengine.com/ai/console/cv
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
VOLC_VISUAL_HOST=visual.volcengineapi.com
VOLC_REGION=cn-north-1
VOLC_OMNIHUMAN_REQ_KEY=realman_avatar_picture_omni_human
VOLC_OMNIHUMAN_SUBMIT_ACTION=CVSync2AsyncSubmitTask
VOLC_OMNIHUMAN_QUERY_ACTION=CVSync2AsyncGetResult

# ===== 火山引擎语音合成（大模型 TTS） =====
# 控制台: https://console.volcengine.com/speech
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=BV700_streaming
VOLC_TTS_HOST=openspeech.bytedance.com

# ===== 火山引擎 RTC（实时互动数字人 / AIGC 智能体） =====
# 控制台: https://console.volcengine.com/rtc
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=
# 若控制台生成了测试 token，填入下面这一项可以直接使用，跳过本地生成
VOLC_RTC_TEST_TOKEN=
# 智能体使用的豆包 EndpointId（在火山方舟创建推理接入点后获得）
VOLC_RTC_AGENT_ENDPOINT_ID=
# 默认指向 RTC AIGC 服务，必要时按控制台版本调整
VOLC_RTC_HOST=rtc.volcengineapi.com
VOLC_RTC_START_ACTION=StartVoiceChat
VOLC_RTC_STOP_ACTION=StopVoiceChat

# ===== 服务器 =====
PORT=8787
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
